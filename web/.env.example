# Copy to .env.local for local dev, or .env.production before `npm run build`.
# Values are baked into the bundle at build time.

# The team's estimate API (POST /estimate). Production builds already use
# https://a34gvnw0hg.execute-api.ap-southeast-1.amazonaws.com/estimate by default
# (see src/config.ts). Set this only to point somewhere else, or set it EMPTY for demo data.
# `npm run dev` uses demo data; `npm run dev:live` uses the live API through a local proxy.
# VITE_ESTIMATE_URL=https://a34gvnw0hg.execute-api.ap-southeast-1.amazonaws.com/estimate

# For demo mode (synthetic data, clearly labelled) in a production build: VITE_ESTIMATE_URL=

# Optional: link to the user-evaluation feedback form (MS Forms / Google Forms).
VITE_FEEDBACK_URL=

# Optional: request timeout in milliseconds (default 20000; Lambda cold starts with
# the model can take several seconds).
VITE_API_TIMEOUT_MS=20000
